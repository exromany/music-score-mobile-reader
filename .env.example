# APK Signing Configuration
# Copy this file to .env and fill in your values for local release builds

# Path to your keystore file
KEYSTORE_PATH=/path/to/your/keystore.jks

# Keystore password
KEYSTORE_PASSWORD=your_keystore_password

# Key alias name
KEY_ALIAS=your_key_alias

# Key password
KEY_PASSWORD=your_key_password

# For GitHub Actions, set these as repository secrets:
# - KEYSTORE_BASE64: base64 -i keystore.jks | tr -d '\n'
# - KEYSTORE_PASSWORD
# - KEY_ALIAS
# - KEY_PASSWORD
